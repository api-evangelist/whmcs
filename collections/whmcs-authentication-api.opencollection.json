{
  "opencollection": "1.0.0",
  "info": {
    "name": "WHMCS Authentication API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "identifier",
      "value": "{{identifier}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate Login",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your-domain}/includes/api.php/?action=ValidateLogin",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Validate client login credentials against WHMCS."
        },
        {
          "info": {
            "name": "Create SSO Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your-domain}/includes/api.php/?action=CreateSsoToken",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Create a single sign-on token for a client or admin user."
        }
      ]
    }
  ],
  "bundled": true
}